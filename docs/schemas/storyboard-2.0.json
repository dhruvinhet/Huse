{
  "$defs": {
    "AssetKind": {
      "description": "Kinds of semantic assets available to the V2 resolver.",
      "enum": [
        "icon",
        "svg",
        "line_art",
        "template",
        "image"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetQuery": {
      "additionalProperties": false,
      "description": "Describe an asset semantically without naming a file.",
      "properties": {
        "concept": {
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "asset_kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "style_id": {
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        },
        "required_semantics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Semantics",
          "type": "array"
        }
      },
      "required": [
        "concept",
        "asset_kind",
        "style_id"
      ],
      "title": "AssetQuery",
      "type": "object"
    },
    "AttentionCue": {
      "additionalProperties": false,
      "description": "Describe where the viewer should look during a beat.",
      "properties": {
        "cue": {
          "enum": [
            "highlight",
            "dim",
            "zoom",
            "pulse",
            "underline",
            "glow",
            "focus"
          ],
          "title": "Cue",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "intensity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        }
      },
      "required": [
        "cue",
        "target_ids"
      ],
      "title": "AttentionCue",
      "type": "object"
    },
    "CameraIntent": {
      "additionalProperties": false,
      "description": "Describe camera intent before geometric planning.",
      "properties": {
        "operation": {
          "enum": [
            "fit",
            "pan",
            "zoom",
            "focus",
            "track",
            "hold"
          ],
          "title": "Operation",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "emphasis": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Emphasis",
          "type": "number"
        }
      },
      "required": [
        "operation"
      ],
      "title": "CameraIntent",
      "type": "object"
    },
    "ConstraintStrength": {
      "description": "Priority used when resolving competing layout constraints.",
      "enum": [
        "required",
        "strong",
        "medium",
        "weak"
      ],
      "title": "ConstraintStrength",
      "type": "string"
    },
    "ConstraintType": {
      "description": "Supported relationships understood by the layout engine.",
      "enum": [
        "align",
        "distribute",
        "contain",
        "anchor",
        "connect",
        "avoid_overlap",
        "min_gap",
        "same_size",
        "aspect_ratio",
        "order",
        "near",
        "far_from"
      ],
      "title": "ConstraintType",
      "type": "string"
    },
    "JsonValue": {},
    "LayoutConstraint": {
      "additionalProperties": false,
      "description": "Express a geometric relationship without pixel coordinates.",
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ConstraintType"
        },
        "subject_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Ids",
          "type": "array"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "strength": {
          "$ref": "#/$defs/ConstraintStrength",
          "default": "strong"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "constraint_id",
        "type",
        "subject_ids"
      ],
      "title": "LayoutConstraint",
      "type": "object"
    },
    "OperationType": {
      "description": "Supported state transitions for persistent objects.",
      "enum": [
        "create",
        "update",
        "move",
        "resize",
        "highlight",
        "dim",
        "morph",
        "duplicate",
        "connect",
        "disconnect",
        "erase",
        "show",
        "hide",
        "group",
        "ungroup"
      ],
      "title": "OperationType",
      "type": "string"
    },
    "VisualBeat": {
      "additionalProperties": false,
      "description": "Represent one pedagogical visual step and its intended speech.",
      "properties": {
        "beat_id": {
          "minLength": 1,
          "title": "Beat Id",
          "type": "string"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "concept_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "teaching_intent": {
          "minLength": 1,
          "title": "Teaching Intent",
          "type": "string"
        },
        "phrase_intent": {
          "minLength": 1,
          "title": "Phrase Intent",
          "type": "string"
        },
        "purpose": {
          "default": "introduce",
          "enum": [
            "introduce",
            "demonstrate",
            "compare",
            "transform",
            "connect",
            "emphasize",
            "summarize"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "estimated_duration": {
          "exclusiveMinimum": 0,
          "title": "Estimated Duration",
          "type": "number"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/VisualOperation"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "attention": {
          "items": {
            "$ref": "#/$defs/AttentionCue"
          },
          "title": "Attention",
          "type": "array"
        },
        "camera_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "beat_id",
        "section_id",
        "concept_ids",
        "teaching_intent",
        "phrase_intent",
        "estimated_duration",
        "operations"
      ],
      "title": "VisualBeat",
      "type": "object"
    },
    "VisualObjectSpec": {
      "additionalProperties": false,
      "description": "Describe a semantic object before layout and rendering.",
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "semantic_role": {
          "minLength": 1,
          "title": "Semantic Role",
          "type": "string"
        },
        "concept_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Concept Ids",
          "type": "array"
        },
        "content": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Content",
          "type": "object"
        },
        "style_token": {
          "default": "concept.primary",
          "minLength": 1,
          "title": "Style Token",
          "type": "string"
        },
        "asset_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "$ref": "#/$defs/VisualObjectSpec"
          },
          "title": "Children",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/LayoutConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "accessibility_label": {
          "minLength": 1,
          "title": "Accessibility Label",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "kind",
        "semantic_role",
        "accessibility_label"
      ],
      "title": "VisualObjectSpec",
      "type": "object"
    },
    "VisualOperation": {
      "additionalProperties": false,
      "description": "Describe one semantic mutation of the visual document.",
      "properties": {
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/OperationType"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "operation",
        "target_ids"
      ],
      "title": "VisualOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe a complete persistent, storyboard-first visual lesson.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/VisualBeat"
      },
      "minItems": 1,
      "title": "Beats",
      "type": "array"
    },
    "initial_objects": {
      "items": {
        "$ref": "#/$defs/VisualObjectSpec"
      },
      "title": "Initial Objects",
      "type": "array"
    },
    "final_learning_summary": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Final Learning Summary",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "title",
    "beats"
  ],
  "title": "Storyboard",
  "type": "object",
  "$id": "whiteboard/storyboard-2.0"
}