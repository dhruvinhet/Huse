{
  "$defs": {
    "ConceptEdge": {
      "additionalProperties": false,
      "description": "Represent one directed semantic relationship.",
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/ConceptRelation"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "edge_id",
        "source_id",
        "target_id",
        "relation"
      ],
      "title": "ConceptEdge",
      "type": "object"
    },
    "ConceptGraph": {
      "additionalProperties": false,
      "description": "Represent validated concepts, relationships, and teaching order.",
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "objectives": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Objectives",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ConceptNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/ConceptEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "teaching_sequence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Teaching Sequence",
          "type": "array"
        }
      },
      "required": [
        "objectives",
        "nodes",
        "teaching_sequence"
      ],
      "title": "ConceptGraph",
      "type": "object"
    },
    "ConceptNode": {
      "additionalProperties": false,
      "description": "Represent one teachable concept and its visual affordances.",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "importance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Importance",
          "type": "number"
        },
        "prerequisites": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "teaching_order": {
          "minimum": 0,
          "title": "Teaching Order",
          "type": "integer"
        },
        "visual_affordances": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Visual Affordances",
          "type": "array"
        }
      },
      "required": [
        "concept_id",
        "label",
        "definition",
        "importance",
        "teaching_order"
      ],
      "title": "ConceptNode",
      "type": "object"
    },
    "ConceptRelation": {
      "description": "Supported educational relationships between concepts.",
      "enum": [
        "depends_on",
        "part_of",
        "causes",
        "transforms_to",
        "contrasts_with",
        "example_of",
        "flows_to"
      ],
      "title": "ConceptRelation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Describe the educational plan consumed by visual planning.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "concept_graph": {
      "$ref": "#/$defs/ConceptGraph"
    },
    "misconceptions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Misconceptions",
      "type": "array"
    },
    "assessment_prompts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Assessment Prompts",
      "type": "array"
    }
  },
  "required": [
    "title",
    "summary",
    "concept_graph"
  ],
  "title": "LessonPlan",
  "type": "object",
  "$id": "whiteboard/lesson-plan-2.0"
}