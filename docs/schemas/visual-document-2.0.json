{
  "$defs": {
    "AssetKind": {
      "description": "Kinds of semantic assets available to the V2 resolver.",
      "enum": [
        "icon",
        "svg",
        "line_art",
        "template",
        "image"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetQuery": {
      "additionalProperties": false,
      "description": "Describe an asset semantically without naming a file.",
      "properties": {
        "concept": {
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "asset_kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "style_id": {
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        },
        "required_semantics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Semantics",
          "type": "array"
        }
      },
      "required": [
        "concept",
        "asset_kind",
        "style_id"
      ],
      "title": "AssetQuery",
      "type": "object"
    },
    "ConstraintStrength": {
      "description": "Priority used when resolving competing layout constraints.",
      "enum": [
        "required",
        "strong",
        "medium",
        "weak"
      ],
      "title": "ConstraintStrength",
      "type": "string"
    },
    "ConstraintType": {
      "description": "Supported relationships understood by the layout engine.",
      "enum": [
        "align",
        "distribute",
        "contain",
        "anchor",
        "connect",
        "avoid_overlap",
        "min_gap",
        "same_size",
        "aspect_ratio",
        "order",
        "near",
        "far_from"
      ],
      "title": "ConstraintType",
      "type": "string"
    },
    "JsonValue": {},
    "LayoutConstraint": {
      "additionalProperties": false,
      "description": "Express a geometric relationship without pixel coordinates.",
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ConstraintType"
        },
        "subject_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Ids",
          "type": "array"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "strength": {
          "$ref": "#/$defs/ConstraintStrength",
          "default": "strong"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "constraint_id",
        "type",
        "subject_ids"
      ],
      "title": "LayoutConstraint",
      "type": "object"
    },
    "ObjectLifecycle": {
      "description": "Observable lifecycle states for a persistent visual object.",
      "enum": [
        "visible",
        "emphasized",
        "dimmed",
        "hidden",
        "removed"
      ],
      "title": "ObjectLifecycle",
      "type": "string"
    },
    "ObjectState": {
      "additionalProperties": false,
      "description": "Represent mutable presentation state for one semantic object.",
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/ObjectLifecycle",
          "default": "visible"
        },
        "content": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Content",
          "type": "object"
        },
        "style_token": {
          "default": "concept.primary",
          "minLength": 1,
          "title": "Style Token",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "child_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Child Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "object_id",
        "kind"
      ],
      "title": "ObjectState",
      "type": "object"
    },
    "VisualObjectSpec": {
      "additionalProperties": false,
      "description": "Describe a semantic object before layout and rendering.",
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "semantic_role": {
          "minLength": 1,
          "title": "Semantic Role",
          "type": "string"
        },
        "concept_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Concept Ids",
          "type": "array"
        },
        "content": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Content",
          "type": "object"
        },
        "style_token": {
          "default": "concept.primary",
          "minLength": 1,
          "title": "Style Token",
          "type": "string"
        },
        "asset_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "$ref": "#/$defs/VisualObjectSpec"
          },
          "title": "Children",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/LayoutConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "accessibility_label": {
          "minLength": 1,
          "title": "Accessibility Label",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "kind",
        "semantic_role",
        "accessibility_label"
      ],
      "title": "VisualObjectSpec",
      "type": "object"
    },
    "VisualState": {
      "additionalProperties": false,
      "description": "Represent an immutable checkpoint after applying one visual beat.",
      "properties": {
        "state_id": {
          "minLength": 1,
          "title": "State Id",
          "type": "string"
        },
        "beat_id": {
          "minLength": 1,
          "title": "Beat Id",
          "type": "string"
        },
        "parent_state_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent State Id"
        },
        "object_states": {
          "additionalProperties": {
            "$ref": "#/$defs/ObjectState"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Object States",
          "type": "object"
        }
      },
      "required": [
        "state_id",
        "beat_id",
        "object_states"
      ],
      "title": "VisualState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent initial semantic objects and materialized state history.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "initial_objects": {
      "items": {
        "$ref": "#/$defs/VisualObjectSpec"
      },
      "title": "Initial Objects",
      "type": "array"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/VisualState"
      },
      "minItems": 1,
      "title": "States",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "states"
  ],
  "title": "VisualDocument",
  "type": "object",
  "$id": "whiteboard/visual-document-2.0"
}